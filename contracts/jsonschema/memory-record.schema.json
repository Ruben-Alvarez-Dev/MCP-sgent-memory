{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jart-os:contracts:memory-record:1.0.0",
  "title": "Jart Memory authoritative record version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_id",
    "version_id",
    "territory_id",
    "tenant_id",
    "user_id",
    "agent_definition_id",
    "agent_instance_id",
    "source_session_id",
    "source_task_id",
    "source_event_id",
    "scope",
    "classification",
    "record_state",
    "index_state",
    "content_ref",
    "content_hash",
    "parent_version_id",
    "derived_from_version_ids",
    "occurred_at",
    "ingested_at",
    "created_at",
    "updated_at",
    "valid_from",
    "valid_to",
    "superseded_at",
    "tombstoned_at",
    "retention_class",
    "policy_version"
  ],
  "properties": {
    "schema_version": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/semantic_version" },
    "memory_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
    "version_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
    "territory_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
    "tenant_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
    "user_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/nullable_uuid_v7" },
    "agent_definition_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/nullable_uuid_v7" },
    "agent_instance_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/nullable_uuid_v7" },
    "source_session_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
    "source_task_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
    "source_event_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
    "scope": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/memory_scope" },
    "classification": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/classification" },
    "record_state": { "type": "string", "enum": ["active", "superseded", "tombstoned", "quarantined"] },
    "index_state": { "type": "string", "enum": ["pending", "indexed", "failed"] },
    "content_ref": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/content_reference" },
    "content_hash": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/sha256" },
    "parent_version_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/nullable_uuid_v7" },
    "derived_from_version_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" }
    },
    "occurred_at": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/utc_rfc3339" },
    "ingested_at": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/utc_rfc3339" },
    "created_at": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/utc_rfc3339" },
    "updated_at": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/utc_rfc3339" },
    "valid_from": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/utc_rfc3339" },
    "valid_to": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/nullable_utc_rfc3339" },
    "superseded_at": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/nullable_utc_rfc3339" },
    "tombstoned_at": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/nullable_utc_rfc3339" },
    "retention_class": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "policy_version": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/semantic_version" }
  }
}
