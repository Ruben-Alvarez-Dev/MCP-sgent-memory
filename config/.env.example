# ── Paths ─────────────────────────────────────────────────────────
# Project root — every data path lives inside it (env_loader derives the rest)
MEMORY_SERVER_DIR=/absolute/path/to/MCP-agent-memory

# ── Qdrant ────────────────────────────────────────────────────────
# Qdrant HTTP endpoint
QDRANT_URL=http://127.0.0.1:6333
# Main memory collection (must match the router's collection names)
QDRANT_COLLECTION=L0_L4_memory
# Conversations collection (retrieval/__init__.py)
CONV_COLLECTION=L2_conversations
# Legacy alias used by the router — keep equal to QDRANT_COLLECTION
MEM0_COLLECTION=L0_L4_memory

# ── Embedding ─────────────────────────────────────────────────────
# Backend: http (OpenAI-compatible endpoint) | llama_server | llama_cpp | noop
EMBEDDING_BACKEND=http
# Endpoint for the http backend (Ollama serves /v1/embeddings)
EMBEDDING_ENDPOINT=http://127.0.0.1:11434/v1/embeddings
# Embedding model tag (target: qwen3-embedding:0.6b — see ADR-0006)
EMBEDDING_MODEL=bge-m3
# Vector dimensionality — must match the Qdrant collections (1024)
EMBEDDING_DIM=1024

# ── LLM ───────────────────────────────────────────────────────────
# Backend: ollama | llama_cpp — leave UNSET to let the tier resolver pick
LLM_BACKEND=ollama
# Primary model tag (tier resolver may degrade explicitly, see model_tier.py)
LLM_MODEL=qwen2.5:7b
# Micro-LLM for ranking/verification/routing
SMALL_LLM_MODEL=qwen3.5:2b
# Ollama daemon base URL
OLLAMA_URL=http://127.0.0.1:11434

# ── Adaptive model tier (ADR-0004 / spec model-stack) ─────────────
# auto = probe the machine; t0..t4 forces a tier
MODEL_TIER=auto
# Seconds before the heartbeat re-probes hardware/backends
MODEL_TIER_TTL=900

# ── Sidecar HTTP API ──────────────────────────────────────────────
# Port for the Backpack API (plugin hooks → fetch)
AUTOMEM_API_PORT=8890
