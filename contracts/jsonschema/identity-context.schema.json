{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jart-os:contracts:identity-context:1.0.0",
  "title": "Verified Jart Memory identity context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "territory_id",
    "tenant_id",
    "principal_kind",
    "principal_id",
    "user_id",
    "agent_definition_id",
    "agent_instance_id",
    "domain_id",
    "team_id",
    "session_id",
    "task_id",
    "plaza_id",
    "credential_version",
    "policy_version",
    "purpose",
    "scope_ceiling",
    "capabilities",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/semantic_version" },
    "context_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
    "territory_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
    "tenant_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
    "principal_kind": { "type": "string", "enum": ["user", "agent", "service"] },
    "principal_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
    "user_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/nullable_uuid_v7" },
    "agent_definition_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/nullable_uuid_v7" },
    "agent_instance_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/nullable_uuid_v7" },
    "domain_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/nullable_uuid_v7" },
    "team_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/nullable_uuid_v7" },
    "session_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
    "task_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
    "plaza_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
    "credential_version": { "type": "integer", "minimum": 1 },
    "policy_version": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/semantic_version" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 128 },
    "scope_ceiling": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/memory_scope" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/capability" }
    },
    "issued_at": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/utc_rfc3339" },
    "expires_at": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/utc_rfc3339" }
  },
  "allOf": [
    {
      "if": { "properties": { "principal_kind": { "const": "agent" } } },
      "then": {
        "properties": {
          "user_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
          "agent_definition_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" },
          "agent_instance_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" }
        }
      }
    },
    {
      "if": { "properties": { "principal_kind": { "const": "user" } } },
      "then": {
        "properties": {
          "user_id": { "$ref": "urn:jart-os:contracts:common:1.0.0#/$defs/uuid_v7" }
        }
      }
    }
  ]
}
