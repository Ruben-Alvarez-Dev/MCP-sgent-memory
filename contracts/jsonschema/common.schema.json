{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jart-os:contracts:common:1.0.0",
  "title": "Jart Memory common contract definitions",
  "type": "object",
  "$defs": {
    "uuid_v7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utc_rfc3339": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "nullable_utc_rfc3339": {
      "oneOf": [
        { "$ref": "#/$defs/utc_rfc3339" },
        { "type": "null" }
      ]
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_uuid_v7": {
      "oneOf": [
        { "$ref": "#/$defs/uuid_v7" },
        { "type": "null" }
      ]
    },
    "memory_scope": {
      "type": "string",
      "enum": [
        "session_private",
        "agent_private",
        "team_private",
        "domain_controlled",
        "tenant_controlled",
        "global_golden",
        "external_rag"
      ]
    },
    "classification": {
      "type": "string",
      "enum": ["private", "internal", "confidential", "restricted", "public"]
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
    },
    "content_reference": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 2048
    }
  }
}
