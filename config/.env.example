# memory-zero — reference env (copy to config/.env)
# Storage: single data/memory.db (SQLite, no daemon). No QDRANT_* needed.

# Logical collections (legacy env names kept)
QDRANT_COLLECTION=L0_L4_memory
CONV_COLLECTION=L2_conversations
L3_FACTS_COLLECTION=L3_facts

# Embeddings (infrastructure; generation models are forbidden by hard constraint)
EMBEDDING_BACKEND=llama_server
LLAMA_SERVER_URL=http://127.0.0.1:8091
EMBEDDING_DIM=1024

# Identity (M4): register with scripts/register_agent.py, then per agent:
# MEMORY_AGENT_ID=director-1
# MEMORY_AGENT_TOKEN=<token-from-register>
# MEMORY_IDENTITY_MODE=strict

# Sidecar HTTP (M5/ISO-17): optional; unset trusts localhost with WARN
# MEMORY_HTTP_TOKEN=<random-secret>
